# ============================================================================
# Mesa Elections — environment configuration
#
# Copy to .env and fill in. NEVER commit .env.
# Generate all secret values with:  npm run gen:secrets
#
# Only variables prefixed with VITE_ are exposed to the browser bundle.
# Everything else stays on the server. `npm run build` fails if a secret-shaped
# name leaks into apps/web (scripts/check-client-secrets.mjs).
# ============================================================================

# ---------------------------------------------------------------- runtime ---
NODE_ENV=development
PORT=8787
# Comma-separated origins allowed to call the API in development. In production
# the API serves the built SPA from the same origin and this is ignored.
DEV_CORS_ORIGIN=http://localhost:5173

# ------------------------------------------------------------- election -----
# Path to the validated election configuration. The server refuses to start if
# this file is missing or fails validation.
ELECTION_CONFIG_PATH=./config/election.config.json
VOTER_ROLL_PATH=./config/voters.json

# ------------------------------------------------------------- database -----
DATABASE_PATH=./data/elections.sqlite

# ----------------------------------------------------------------- auth -----
# supervised  — the voter selects their own name at a booth with an invigilator
#               present. Identity is established by that person, not by this
#               software. One-vote enforcement is unaffected. This is how Mesa
#               runs the election; see docs/security-model.md §3.1.
# access-code — one-time codes handed out against student ID. Stronger, more
#               admin: printing and distributing slips.
# entra       — Microsoft Entra ID sign-in. Strongest; needs M365 accounts.
AUTH_MODE=supervised

# Shared secret the kiosk browser presents to search the voter roll.
# Prevents the roll being scraped by anyone who can reach the API.
KIOSK_TOKEN=replace-me-kiosk-token-min-32-chars-long

# Global pepper mixed into every access-code hash, in addition to a per-voter
# salt. Rotating this invalidates every issued code.
ACCESS_CODE_PEPPER=replace-me-access-code-pepper-min-32-chars

# Salt for hashing IP addresses and user agents in the audit log, so abuse can
# be investigated without storing personal data.
HASH_SALT=replace-me-hash-salt-min-32-characters-long

# Voting session lifetime.
SESSION_TTL_MINUTES=20

# ---------------------------------------------- Microsoft Entra ID (auth) ---
# Required only when AUTH_MODE=entra.
MICROSOFT_TENANT_ID=00000000-0000-0000-0000-000000000000
MICROSOFT_CLIENT_ID=00000000-0000-0000-0000-000000000000
MICROSOFT_CLIENT_SECRET=replace-me-entra-client-secret
# Must exactly match the redirect URI registered on the app registration.
MICROSOFT_REDIRECT_URI=http://localhost:8787/api/auth/entra/callback

# ---------------------------------------------------- results spreadsheet ---
# sheets — Google Sheets via a service account. What Mesa uses.
# excel  — Excel on Microsoft 365 via Graph.
# spool  — write JSONL to ./.excel-spool. Development only; the server REFUSES
#          to start with this under NODE_ENV=production, because everything
#          would appear to work while nothing reached the spreadsheet.
SPREADSHEET_MODE=spool

# --- Google Sheets -----------------------------------------------------------
# The id from the sheet URL: docs.google.com/spreadsheets/d/<THIS_PART>/edit
SHEETS_SPREADSHEET_ID=
# Tab names inside that spreadsheet. Column names go in row 1 of each tab; the
# server reads them at runtime, so you can reorder columns freely.
# Roll      — everyone eligible, seeded once by `npm run sheets:setup`
# Voters    — one row per person as they vote (this is the "who has voted" log)
# Ballots   — one row per selection, anonymous: no voter reference, ever
# Results   — a timestamped snapshot each time you publish
# Dashboard — live formulas over all of the above
SHEETS_TAB_ROLL=Roll
SHEETS_TAB_VOTERS=Voters
SHEETS_TAB_CANDIDATES=Candidates
SHEETS_TAB_BALLOTS=Ballots
SHEETS_TAB_RESULTS=Results
SHEETS_TAB_DASHBOARD=Dashboard
#
# IMPORTANT: an API key can only READ public sheets — it cannot write. Writing
# needs a service account:
#   1. Google Cloud console → create a project → enable the Google Sheets API
#   2. Create a service account → Keys → Add key → JSON → download
#   3. Open your spreadsheet → Share → paste the service account's email
#      (looks like name@project.iam.gserviceaccount.com) → give it Editor
#   4. Paste the whole downloaded file below as ONE line, or use the file path.
# The key is a credential. Never commit it.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=

# --- Excel on Microsoft 365 (only when SPREADSHEET_MODE=excel) ---------------
EXCEL_TENANT_ID=
EXCEL_CLIENT_ID=
EXCEL_CLIENT_SECRET=
EXCEL_DRIVE_ID=
EXCEL_WORKBOOK_ID=
EXCEL_TABLE_VOTERS=Voters
EXCEL_TABLE_CANDIDATES=Candidates
EXCEL_TABLE_BALLOTS=Ballots
EXCEL_TABLE_RESULTS=Results

# ------------------------------------------------------------ sync worker ---
SYNC_ENABLED=true
SYNC_INTERVAL_MS=5000
SYNC_BATCH_SIZE=25
SYNC_MAX_ATTEMPTS=8

# ------------------------------------------------------- results snapshot ---
# The count publishes itself to the spreadsheet whenever the ballot total
# moves — never on an unchanged count, so the Results tab does not fill with
# thousands of identical rows over a polling day.
#
# Set to false if a running count must NOT be visible to anyone holding the
# spreadsheet while voting is open; publishing then goes back to being a
# deliberate act (`npm run results:publish`).
RESULTS_PUBLISH_ENABLED=true
RESULTS_PUBLISH_INTERVAL_MS=60000

# ---------------------------------------------------------------- admin -----
# Bearer token for /api/admin/* AND for the invigilator monitor at /monitor.
# Give this to whoever is running the room. Must be >= 32 chars in production.
ADMIN_API_TOKEN=replace-me-admin-api-token-min-32-chars

# ------------------------------------------------------- election desk ---
# Sign-in for /monitor: an address and a password, rather than pasting the
# admin token. The password is never stored — only a scrypt hash, which
# this prints for you:
#
#   npm run monitor:password -- desk@school.edu 'a long passphrase'
#
# Leave both unset and the desk asks for ADMIN_API_TOKEN instead, which is
# how it worked before and is still how a script authenticates.
MONITOR_EMAIL=
MONITOR_PASSWORD_HASH=
MONITOR_SESSION_HOURS=12

# ------------------------------------------------------------- frontend -----
# Exposed to the browser. Must contain nothing sensitive.
VITE_APP_NAME=Mesa Elections
VITE_API_BASE_URL=http://localhost:8787
# The kiosk token is also needed by the browser in access-code/dev mode. It is a
# device credential, not a user credential: it gates roll *search* only and can
# cast no vote. Treat it as public-on-the-kiosk.
VITE_KIOSK_TOKEN=replace-me-kiosk-token-min-32-chars-long
# Seconds the celebration screen holds before resetting for the next voter.
VITE_CELEBRATION_SECONDS=4
