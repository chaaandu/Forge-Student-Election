node_modules/
dist/
build/
coverage/
*.tsbuildinfo

# Compiled output belongs in dist/. If tsc is ever invoked without a project
# file it emits beside the sources instead; these rules stop that reaching a
# commit. Run `npm run clean:emit` to clear any that appear.
apps/*/src/**/*.js
apps/*/src/**/*.js.map
apps/*/src/**/*.d.ts
apps/*/src/**/*.d.ts.map
packages/*/src/**/*.js
packages/*/src/**/*.js.map
packages/*/src/**/*.d.ts
packages/*/src/**/*.d.ts.map
!apps/web/src/vite-env.d.ts

# Secrets — never commit
.env
.env.*
!.env.example

# Google service account keys. The real one lives outside the repo entirely
# (~/.mesa-elections/service-account.json); these patterns are a backstop for a
# key downloaded straight into the project by accident.
*service-account*.json
*-iam-gserviceaccount*.json
*.iam.gserviceaccount.com.json
gcp-*.json
**/forge-student-elections-*.json

# Real voter data — personal information, never commit.
# The candidate list and ballot structure DO get committed (they are public and
# worth versioning); the roll of 145 names and school email addresses does not.
apps/server/config/voters.json
Elections Team.xlsx
*.pdf

# Authoritative election data — never commit
data/
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.db

# Generated access codes contain plaintext credentials
access-codes-*.csv
access-codes-*.txt

# Local Excel sync spool (development NullExcelRepository)
.excel-spool/

.DS_Store
.vscode/
.idea/

# Original candidate photographs. These are real students' photos, often many
# megabytes each. `npm run photos:import` writes the cropped, compressed
# versions to apps/web/src/assets/candidates/ — those are committed, and are
# what ship. Deleting an original here does not remove the imported photo.
assets/candidate-photos/*
!assets/candidate-photos/README.md

# Spreadsheets dropped into the repo root are source data about real people
# (rolls, headshot slots). They are inputs, not source code.
/*.xlsx
/*.csv
