# tsc must never emit beside sources; if it does, these catch it
apps/web/src/**/*.js
apps/web/src/**/*.js.map
apps/web/src/**/*.d.ts
!apps/web/src/vite-env.d.ts

# Secrets — never commit
.env
.env.*
!.env.example

# Authoritative election data — never commit
data/
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.db

# Generated access codes contain plaintext credentials
access-codes-*.csv
access-codes-*.txt

